#!/usr/bin/env bash
set -euo pipefail
# cv2

SCRIPT_NAME="$(basename "$0")"
VERSION="2026-07-20"

DEFAULT_OUTPUT="."
DEFAULT_PARALLEL=4

EX_OK=0
EX_USAGE=64
EX_DATAERR=65
EX_NOINPUT=66
EX_CANTCREAT=73
EX_IOERR=74
EX_NOTFOUND=127

CYAN='\033[1;36m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
RESET='\033[0m'

command_name=""
output_dir="$DEFAULT_OUTPUT"
suffix=""
quality=""
resolution=""
parallel="$DEFAULT_PARALLEL"
dry_run=false
verbose=false
yes=false
files=()
pids=()
failed=false
result_code=0

# region common functions

usage() {
  cat <<EOF_USAGE
$SCRIPT_NAME version $VERSION

Convert media, copy files, and create or extract archives.
Relative directory structure is preserved under the output directory.

Usage:
  $SCRIPT_NAME [options] command file...
  $SCRIPT_NAME validate

Commands:
  cp

  264       H.264 + AAC -> MP4
  265       H.265 + Opus -> MKV
  10bit     10-bit H.265 + Opus -> MKV
  vcrop     detect crop, then encode H.265 + Opus -> MKV
  vstrip    copy streams and remove technical metadata
  gif       palette-based animated GIF

  mp3       MP3 (libmp3lame)
  flac      FLAC
  ogg       Ogg Vorbis
  opus      Opus through ffmpeg + opusenc
  wav       16-bit PCM WAV

  jpg       JPEG
  png       PNG
  avif      AVIF

  7z        create one .7z archive per input
  7zp       create password-protected .7z archives
  zip       create one .zip archive per input
  un7z      extract each .7z into its own directory
  unzip     extract each .zip into its own directory

  validate  check every external command used by $SCRIPT_NAME

Options:
  -o, --output DIR        Output root. Default: $DEFAULT_OUTPUT
  -s, --suffix TEXT       Add .TEXT before the output extension
  -q, --quality VALUE     Quality or CRF; meaning depends on command
  -r, --resolution VALUE  Resize images or video
  -p, --parallel N        Parallel image/audio jobs. Default: $DEFAULT_PARALLEL
  -n, --dry-run           Print commands without running them
  -v, --verbose           Print input and output paths
  -y, --yes               Allow overwriting or updating existing outputs
  -h, --help              Show this help

Resolution:
  Images  Passed directly to ImageMagick, for example: x720, 1920x1080, 50%
  Video   Target height: 480p, 720p, 1080p, 1440p, or 2160p

Quality defaults:
  264       CRF 23
  265       CRF 28
  10bit     CRF 28
  vcrop     CRF 28
  jpg       quality 90
  avif      quality 60
  mp3       VBR quality 2 (lower is better)
  ogg       Vorbis quality 6

Examples:
  $SCRIPT_NAME jpg -q 88 -r 50% -o converted images/*.png
  $SCRIPT_NAME -nvo converted --parallel 15 avif images/**/*.png
  $SCRIPT_NAME 265 -q 26 -r 1080p video.mov
  $SCRIPT_NAME 10bit -y movie.mkv
  $SCRIPT_NAME zip files/*
  $SCRIPT_NAME validate

Exit codes:
  0    success
  64   invalid usage
  65   invalid data or crop not found
  66   input does not exist
  73   output cannot be created
  74   conversion or I/O failed
  127  required command not found
EOF_USAGE
}

error() {
  echo -e "${RED}Error:${RESET} $*" >&2
}

warn() {
  echo -e "${YELLOW}Warning:${RESET} $*" >&2
}

need_commands() {
  local missing=false
  local command

  for command in "$@"; do
    if ! command -v "$command" >/dev/null 2>&1; then
      error "required command not found: $command"
      missing=true
    fi
  done

  "$missing" && return "$EX_NOTFOUND"
  return "$EX_OK"
}

record_status() {
  local status="$1"

  ((status == 0)) && return
  failed=true
  ((result_code == 0)) && result_code="$status"
}

print_command() {
  printf '  '
  printf '%q ' "$@"
  printf '\n'
}

run_command() {
  if "$dry_run"; then
    print_command "$@"
    return 0
  fi

  "$@"
}

queue_job() {
  if "$dry_run"; then
    if "$@"; then
      return
    else
      record_status "$?"
      return
    fi
  fi

  "$@" &
  pids+=("$!")

  if ((${#pids[@]} >= parallel)); then
    wait_jobs
  fi
}

wait_jobs() {
  local pid
  local status

  for pid in "${pids[@]}"; do
    if wait "$pid"; then
      :
    else
      status="$?"
      record_status "$status"
    fi
  done

  pids=()
}

normalize_suffix() {
  suffix="${suffix#.}"
  [[ -z "$suffix" ]] || suffix=".$suffix"
}

relative_input_path() {
  local path="$1"
  path="${path#/}"
  while [[ "$path" == ./* ]]; do
    path="${path#./}"
  done
  printf '%s' "$path"
}

media_output_path() {
  local source="$1"
  local extension="$2"
  local relative
  local directory
  local basename
  local stem

  relative="$(relative_input_path "$source")"
  directory="$(dirname -- "$relative")"
  basename="$(basename -- "$relative")"
  stem="${basename%.*}"

  if [[ "$directory" == "." ]]; then
    printf '%s/%s%s.%s' "$output_dir" "$stem" "$suffix" "$extension"
  else
    printf '%s/%s/%s%s.%s' "$output_dir" "$directory" "$stem" "$suffix" "$extension"
  fi
}

copy_output_path() {
  local source="$1"
  local relative
  local directory
  local basename
  local stem
  local extension

  relative="$(relative_input_path "$source")"
  directory="$(dirname -- "$relative")"
  basename="$(basename -- "$relative")"

  if [[ "$basename" == *.* && "$basename" != .* ]]; then
    stem="${basename%.*}"
    extension=".${basename##*.}"
  else
    stem="$basename"
    extension=""
  fi

  if [[ "$directory" == "." ]]; then
    printf '%s/%s%s%s' "$output_dir" "$stem" "$suffix" "$extension"
  else
    printf '%s/%s/%s%s%s' "$output_dir" "$directory" "$stem" "$suffix" "$extension"
  fi
}

archive_output_path() {
  local source="$1"
  local extension="$2"
  local relative

  relative="$(relative_input_path "$source")"
  printf '%s/%s%s.%s' "$output_dir" "$relative" "$suffix" "$extension"
}

extract_output_path() {
  local source="$1"
  local relative
  local directory
  local basename
  local stem

  relative="$(relative_input_path "$source")"
  directory="$(dirname -- "$relative")"
  basename="$(basename -- "$relative")"
  stem="${basename%.*}"

  if [[ "$directory" == "." ]]; then
    printf '%s/%s%s' "$output_dir" "$stem" "$suffix"
  else
    printf '%s/%s/%s%s' "$output_dir" "$directory" "$stem" "$suffix"
  fi
}

prepare_output() {
  local source="$1"
  local target="$2"
  local allow_directory="${3:-false}"

  if "$verbose"; then
    echo -e "${CYAN}$source${RESET} -> ${GREEN}$target${RESET}"
  fi

  if [[ "$source" == "$target" || "./$source" == "$target" ]]; then
    error "input and output are the same: $source"
    return "$EX_CANTCREAT"
  fi

  if [[ -e "$target" && "$yes" == false ]]; then
    error "output already exists: $target"
    return "$EX_CANTCREAT"
  fi

  if "$dry_run"; then
    return 0
  fi

  if "$allow_directory"; then
    mkdir -p -- "$target" || return "$EX_CANTCREAT"
  else
    mkdir -p -- "$(dirname -- "$target")" || return "$EX_CANTCREAT"
  fi
}

video_scale_args() {
  local value="$1"
  local height

  [[ "$value" =~ ^(480|720|1080|1440|2160)p$ ]] || {
    error "unsupported video resolution: $value"
    return "$EX_USAGE"
  }

  height="${BASH_REMATCH[1]}"
  printf 'scale=-2:%s' "$height"
}

validate_options() {
  local quality_supported=false
  local resolution_supported=false

  case "$command_name" in
    264|265|10bit|vcrop|jpg|avif|mp3|ogg) quality_supported=true ;;
  esac

  case "$command_name" in
    264|265|10bit|vcrop|gif|jpg|png|avif) resolution_supported=true ;;
  esac

  if [[ -n "$quality" ]] && ! "$quality_supported"; then
    error "--quality is not supported for command '$command_name'"
    return "$EX_USAGE"
  fi

  if [[ -n "$resolution" ]] && ! "$resolution_supported"; then
    error "--resolution is not supported for command '$command_name'"
    return "$EX_USAGE"
  fi

  [[ "$parallel" =~ ^[1-9][0-9]*$ ]] || {
    error "--parallel must be a positive integer"
    return "$EX_USAGE"
  }
}

print_summary() {
  echo -e "Command:     ${GREEN}$command_name${RESET}"
  echo -e "Files count: ${GREEN}${#files[@]}${RESET}"
  echo -e "Output:      ${GREEN}$output_dir${RESET}"
  [[ -z "$suffix" ]] || echo -e "Suffix:      ${GREEN}$suffix${RESET}"
  [[ -z "$quality" ]] || echo -e "Quality:     ${GREEN}$quality${RESET}"
  [[ -z "$resolution" ]] || echo -e "Resolution:  ${GREEN}$resolution${RESET}"

  case "$command_name" in
    jpg|png|avif|mp3|flac|ogg|opus|wav)
      echo -e "Parallel:    ${GREEN}$parallel${RESET}"
      ;;
  esac

  "$dry_run" && echo -e "Mode:        ${YELLOW}dry-run${RESET}"
  "$yes" && echo -e "Overwrite:   ${YELLOW}yes${RESET}"
  echo
}

# endregion

# region argument functions

require_option_value() {
  local option="$1"
  local value="${2:-}"

  [[ -n "$value" ]] || {
    error "$option requires a value"
    return "$EX_USAGE"
  }
}

parse_short_options() {
  local cluster="${1#-}"
  local next_value="${2:-}"
  local consumed_next=false
  local char
  local value

  while [[ -n "$cluster" ]]; do
    char="${cluster:0:1}"
    cluster="${cluster:1}"

    case "$char" in
      n) dry_run=true ;;
      v) verbose=true ;;
      y) yes=true ;;
      h)
        usage
        exit 0
        ;;
      o|s|q|r|p)
        if [[ -n "$cluster" ]]; then
          value="$cluster"
          cluster=""
        else
          require_option_value "-$char" "$next_value"
          value="$next_value"
          consumed_next=true
        fi

        case "$char" in
          o) output_dir="$value" ;;
          s) suffix="$value" ;;
          q) quality="$value" ;;
          r) resolution="$value" ;;
          p) parallel="$value" ;;
        esac
        ;;
      *)
        error "unknown option: -$char"
        return "$EX_USAGE"
        ;;
    esac
  done

  "$consumed_next"
}

parse_args() {
  local arg
  local consumed

  while (($#)); do
    arg="$1"

    case "$arg" in
      --)
        shift
        files+=("$@")
        break
        ;;
      --help)
        usage
        exit 0
        ;;
      --dry-run) dry_run=true ;;
      --verbose) verbose=true ;;
      --yes) yes=true ;;
      --output|--suffix|--quality|--resolution|--parallel)
        require_option_value "$arg" "${2:-}"
        case "$arg" in
          --output) output_dir="$2" ;;
          --suffix) suffix="$2" ;;
          --quality) quality="$2" ;;
          --resolution) resolution="$2" ;;
          --parallel) parallel="$2" ;;
        esac
        shift
        ;;
      --output=*|--suffix=*|--quality=*|--resolution=*|--parallel=*)
        case "$arg" in
          --output=*) output_dir="${arg#*=}" ;;
          --suffix=*) suffix="${arg#*=}" ;;
          --quality=*) quality="${arg#*=}" ;;
          --resolution=*) resolution="${arg#*=}" ;;
          --parallel=*) parallel="${arg#*=}" ;;
        esac
        ;;
      --*)
        error "unknown option: $arg"
        return "$EX_USAGE"
        ;;
      -?*)
        if parse_short_options "$arg" "${2:-}"; then
          shift
        else
          consumed=$?
          if ((consumed == 1)); then
            :
          else
            return "$consumed"
          fi
        fi
        ;;
      *)
        if [[ -z "$command_name" ]]; then
          command_name="$arg"
        else
          files+=("$arg")
        fi
        ;;
    esac

    shift
  done

  normalize_suffix
}

# endregion

# region video functions

convert_video() {
  local source="$1"
  local target
  local q
  local scale=""
  local overwrite=()
  local filters=()
  local cmd=()

  "$yes" && overwrite=(-y)
  [[ -z "$resolution" ]] || scale="$(video_scale_args "$resolution")"

  case "$command_name" in
    264)
      q="${quality:-23}"
      target="$(media_output_path "$source" 264.mp4)"
      [[ -z "$scale" ]] || filters=(-vf "$scale")
      cmd=(ffmpeg -hide_banner "${overwrite[@]}" -i "$source" -map 0 -c copy -c:v libx264 -preset slow -crf "$q" -c:a aac -pix_fmt yuv420p -movflags +faststart "${filters[@]}" "$target")
      ;;
    265)
      q="${quality:-28}"
      target="$(media_output_path "$source" 265.mkv)"
      [[ -z "$scale" ]] || filters=(-vf "$scale")
      cmd=(ffmpeg -hide_banner "${overwrite[@]}" -i "$source" -map 0 -c copy -c:v libx265 -crf "$q" -c:a libopus -pix_fmt yuv420p "${filters[@]}" "$target")
      ;;
    10bit)
      q="${quality:-28}"
      target="$(media_output_path "$source" 10bit.mkv)"
      [[ -z "$scale" ]] || filters=(-vf "$scale")
      cmd=(ffmpeg -hide_banner "${overwrite[@]}" -i "$source" -map 0 -c copy -c:v libx265 -crf "$q" -c:a libopus -pix_fmt yuv420p10le "${filters[@]}" "$target")
      ;;
    vcrop)
      q="${quality:-28}"
      target="$(media_output_path "$source" crop.mkv)"
      local crop
      local detect=(ffmpeg -hide_banner -ss 10 -i "$source" -frames:v 2 -vf cropdetect -f null -)

      if "$dry_run"; then
        print_command "${detect[@]}"
        crop="crop=DETECTED"
      else
        crop="$("${detect[@]}" 2>&1 | sed -n 's/.*\(crop=[0-9:]*\).*/\1/p' | tail -n 1)"
      fi

      [[ -n "$crop" ]] || {
        error "cropdetect found no crop for: $source"
        return "$EX_DATAERR"
      }

      filters=("$crop")
      [[ -z "$scale" ]] || filters+=("$scale")
      cmd=(ffmpeg -hide_banner "${overwrite[@]}" -i "$source" -map 0 -c copy -c:v libx265 -crf "$q" -c:a libopus -pix_fmt yuv420p -vf "$(IFS=,; echo "${filters[*]}")" "$target")
      ;;
    vstrip)
      target="$(media_output_path "$source" "strip.${source##*.}")"
      local metadata=()
      local key
      local keys=(
        encoder ENCODER BPS DURATION NUMBER_OF_FRAMES NUMBER_OF_BYTES
        _STATISTICS_WRITING_APP _STATISTICS_WRITING_DATE_UTC _STATISTICS_TAGS
      )

      for key in "${keys[@]}"; do
        metadata+=(-metadata "$key=" -metadata:s "$key=" -metadata:s "$key-eng=")
      done

      cmd=(ffmpeg -hide_banner "${overwrite[@]}" -i "$source" -map 0 -c copy "${metadata[@]}" "$target")
      ;;
    gif)
      target="$(media_output_path "$source" gif)"
      local gif_filter="fps=15"
      [[ -z "$scale" ]] || gif_filter+=",${scale}:flags=lanczos"
      gif_filter+=",split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse"
      cmd=(ffmpeg -hide_banner "${overwrite[@]}" -i "$source" -filter_complex "$gif_filter" "$target")
      ;;
  esac

  prepare_output "$source" "$target" || return $?
  run_command "${cmd[@]}"
}

# endregion

# region audio functions

convert_audio() {
  local source="$1"
  local target
  local q
  local overwrite=()
  local cmd=()

  "$yes" && overwrite=(-y)

  case "$command_name" in
    mp3)
      q="${quality:-2}"
      target="$(media_output_path "$source" mp3)"
      cmd=(ffmpeg -hide_banner "${overwrite[@]}" -i "$source" -map 0:a:0 -map '0:v?' -c:a libmp3lame -q:a "$q" -c:v copy "$target")
      ;;
    flac)
      target="$(media_output_path "$source" flac)"
      cmd=(ffmpeg -hide_banner "${overwrite[@]}" -i "$source" -map 0:a:0 -map '0:v?' -c:a flac -c:v copy "$target")
      ;;
    ogg)
      q="${quality:-6}"
      target="$(media_output_path "$source" ogg)"
      cmd=(ffmpeg -hide_banner "${overwrite[@]}" -i "$source" -map 0:a:0 -c:a libvorbis -q:a "$q" "$target")
      ;;
    wav)
      target="$(media_output_path "$source" wav)"
      cmd=(ffmpeg -hide_banner "${overwrite[@]}" -i "$source" -map 0:a:0 -c:a pcm_s16le "$target")
      ;;
    opus)
      target="$(media_output_path "$source" opus)"
      prepare_output "$source" "$target" || return $?
      local metadata=()
      local left
      local right
      [[ "${source,,}" == *.ogg || "${source,,}" == *.opus ]] && metadata=(-map_metadata 0:s:0)
      left=(ffmpeg -hide_banner -i "$source" -f flac -c:v copy "${metadata[@]}" -)
      right=(opusenc - "$target")

      if "$yes" && [[ -e "$target" ]] && ! "$dry_run"; then
        rm -f -- "$target"
      fi

      if "$dry_run"; then
        "$yes" && print_command rm -f -- "$target"
        printf '  '
        printf '%q ' "${left[@]}"
        printf '| '
        printf '%q ' "${right[@]}"
        printf '\n'
      else
        "${left[@]}" | "${right[@]}"
      fi
      return
      ;;
  esac

  prepare_output "$source" "$target" || return $?
  run_command "${cmd[@]}"
}

# endregion

# region image functions

convert_image() {
  local source="$1"
  local target
  local q
  local extension="$command_name"
  local cmd=(magick "$source")

  target="$(media_output_path "$source" "$extension")"
  [[ -z "$resolution" ]] || cmd+=(-resize "$resolution")

  case "$command_name" in
    jpg)
      q="${quality:-90}"
      cmd+=(-quality "$q")
      ;;
    avif)
      q="${quality:-60}"
      cmd+=(-quality "$q")
      ;;
  esac

  cmd+=("$target")

  prepare_output "$source" "$target" || return $?
  run_command "${cmd[@]}"
}

# endregion

# region archive functions

process_archive() {
  local source="$1"
  local target
  local lower="${source,,}"
  local cmd=()

  case "$command_name" in
    zip)
      if [[ "$lower" == *.zip ]]; then
        warn "skip existing ZIP input: $source"
        return 0
      fi
      target="$(archive_output_path "$source" zip)"
      cmd=(zip -r -9 "$target" "$source")
      prepare_output "$source" "$target" || return $?
      ;;
    7z|7zp)
      if [[ "$lower" == *.7z ]]; then
        warn "skip existing 7z input: $source"
        return 0
      fi
      target="$(archive_output_path "$source" 7z)"
      cmd=(7z a -t7z -mx=9 -mqs=on)
      [[ "$command_name" == 7zp ]] && cmd+=(-mhe=on -p)
      cmd+=("$target" "$source")
      prepare_output "$source" "$target" || return $?
      ;;
    unzip)
      target="$(extract_output_path "$source")"
      cmd=(unzip)
      "$yes" && cmd+=(-o)
      cmd+=("$source" -d "$target")
      prepare_output "$source" "$target" true || return $?
      ;;
    un7z)
      target="$(extract_output_path "$source")"
      cmd=(7z x)
      "$yes" && cmd+=(-y)
      cmd+=("$source" "-o$target")
      prepare_output "$source" "$target" true || return $?
      ;;
  esac

  run_command "${cmd[@]}"
}

# endregion

# region copy functions

copy_file() {
  local source="$1"
  local target
  local cmd=(cp)

  target="$(copy_output_path "$source")"
  "$yes" && cmd+=(-f)
  cmd+=(-- "$source" "$target")

  prepare_output "$source" "$target" || return $?
  run_command "${cmd[@]}"
}

# endregion

# region validation functions

validate_commands() {
  local commands=(7z cp ffmpeg magick opusenc sed tail unzip zip)
  local missing=false
  local command

  echo "$SCRIPT_NAME version $VERSION"
  echo

  for command in "${commands[@]}"; do
    if command -v "$command" >/dev/null 2>&1; then
      echo -e "${GREEN}OK${RESET}       $command"
    else
      echo -e "${RED}MISSING${RESET}  $command"
      missing=true
    fi
  done

  "$missing" && return "$EX_NOTFOUND"
  echo
  echo -e "${GREEN}All commands are available.${RESET}"
}

# endregion

main() {
  parse_args "$@" || exit $?

  [[ -n "$command_name" ]] || {
    usage
    exit "$EX_USAGE"
  }

  case "$command_name" in
    validate)
      ((${#files[@]} == 0)) || {
        error "validate does not accept files"
        exit "$EX_USAGE"
      }
      [[ "$output_dir" == "$DEFAULT_OUTPUT" && -z "$suffix" && -z "$quality" && -z "$resolution" && "$parallel" == "$DEFAULT_PARALLEL" && "$dry_run" == false && "$verbose" == false && "$yes" == false ]] || {
        error "validate does not accept options"
        exit "$EX_USAGE"
      }
      validate_commands || exit $?
      exit 0
      ;;
    cp|264|265|10bit|vcrop|vstrip|gif|mp3|flac|ogg|opus|wav|jpg|png|avif|7z|7zp|zip|unzip|un7z)
      ;;
    *)
      error "unknown command: $command_name"
      exit "$EX_USAGE"
      ;;
  esac

  ((${#files[@]} > 0)) || {
    error "no input files"
    exit "$EX_USAGE"
  }

  validate_options || exit $?

  local source
  for source in "${files[@]}"; do
    [[ -e "$source" ]] || {
      error "input does not exist: $source"
      exit "$EX_NOINPUT"
    }

    case "$command_name" in
      7z|7zp|zip) ;;
      *)
        [[ -f "$source" ]] || {
          error "input is not a regular file: $source"
          exit "$EX_DATAERR"
        }
        ;;
    esac
  done

  case "$command_name" in
    cp) need_commands cp || exit $? ;;
    264|265|10bit|vstrip|gif|mp3|flac|ogg|wav) need_commands ffmpeg || exit $? ;;
    vcrop) need_commands ffmpeg sed tail || exit $? ;;
    opus) need_commands ffmpeg opusenc || exit $? ;;
    jpg|png|avif) need_commands magick || exit $? ;;
    7z|7zp|un7z) need_commands 7z || exit $? ;;
    zip) need_commands zip || exit $? ;;
    unzip) need_commands unzip || exit $? ;;
  esac

  print_summary

  for source in "${files[@]}"; do
    case "$command_name" in
      jpg|png|avif)
        queue_job convert_image "$source"
        ;;
      mp3|flac|ogg|opus|wav)
        queue_job convert_audio "$source"
        ;;
      264|265|10bit|vcrop|vstrip|gif)
        if convert_video "$source"; then
          :
        else
          record_status "$?"
        fi
        ;;
      7z|7zp|zip|unzip|un7z)
        if process_archive "$source"; then
          :
        else
          record_status "$?"
        fi
        ;;
      cp)
        if copy_file "$source"; then
          :
        else
          record_status "$?"
        fi
        ;;
    esac
  done

  wait_jobs

  if "$failed"; then
    error "one or more operations failed"
    exit "${result_code:-$EX_IOERR}"
  fi

  echo -e "${GREEN}Finished.${RESET}"
}

main "$@"
