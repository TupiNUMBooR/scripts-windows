#!/usr/bin/env bash
set -Eeuo pipefail
# cv-avif

SCRIPT_NAME="$(basename "$0")"

DEFAULT_PATH="."
DEFAULT_MAX_PROCS=8

# region functions

usage() {
  cat <<EOF
  $SCRIPT_NAME - recursively convert images to AVIF.

Converts JPEG, PNG, WebP, and BMP files using ImageMagick.
After a successful conversion, the original file is deleted.

Usage:
  $SCRIPT_NAME [directory] [max_processes]
  $SCRIPT_NAME -h|--help

Arguments:
  directory       Directory to process. Default: $DEFAULT_PATH
  max_processes   Maximum parallel conversions. Default: $DEFAULT_MAX_PROCS

Examples:
  $SCRIPT_NAME
  $SCRIPT_NAME ./images
  $SCRIPT_NAME ./images 4

Requires:
  magick

Exit codes:
  0    Completed successfully.
  2    Invalid command-line arguments.
  65   Invalid input data.
  66   Required input is missing.
  127  Required command is unavailable.
EOF
}

handle_help() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi
}

log() {
  printf '[%s] [%s] %s\n' \
    "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" \
    "$SCRIPT_NAME" \
    "$*" >&2
}

warn() {
  log "[WARN] $*"
}

error() {
  local code="$1"
  shift

  log "[ERROR] $*"
  exit "$code"
}

need_commands() {
  local name

  for name in "$@"; do
    command -v "$name" >/dev/null 2>&1 \
      || error 127 "Missing executable: $name"
  done
}

convert_file() {
  local source="$1"
  local output="${source%.*}.avif"
  local number="$2"

  log "[$number] converting: $source"

  if magick "$source" "$output"; then
    rm -- "$source"
    log "[$number] completed: $output"
  else
    warn "[$number] failed: $source"
    return 1
  fi
}

# endregion

main() {
  handle_help "$@"

  [[ $# -le 2 ]] || error 2 "Expected at most directory and max_processes"

  local path="${1:-$DEFAULT_PATH}"
  local max_procs="${2:-$DEFAULT_MAX_PROCS}"

  [[ -d "$path" ]] || error 66 "Directory does not exist: $path"

  [[ "$max_procs" =~ ^[1-9][0-9]*$ ]] \
    || error 65 "max_processes must be a positive integer"

  need_commands date find magick

  log "Looking for files in $path"

  local -a files=()
  mapfile -d '' -t files < <(
    find "$path" \
      -type f \
      -regextype posix-extended \
      -iregex '.*\.(jpe?g|png|webp|bmp)' \
      -print0
  )

  if ((${#files[@]} == 0)); then
    log "No matching files found."
    exit 0
  fi

  log "Files count: ${#files[@]}"
  log "Max parallel processes: $max_procs"

  read -r -p "Enter to continue, Ctrl-C to abort... "

  local active=0
  local index=0
  local file

  for file in "${files[@]}"; do
    ((++index))

    convert_file "$file" "$index" &

    ((++active))

    if ((active >= max_procs)); then
      wait -n || :
      ((--active))
    fi
  done

  log "Waiting for remaining conversions..."
  wait

  log "Finished."
}

main "$@"
