@startuml
title Shorts Pipeline — Operation DAG (parallel validation)

skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 35
skinparam linetype ortho

' === Legend ===
legend right
|= Color |= Resource type |
|<#ADD8E6>🟦| OpenAI |
|<#D8BFD8>🟪| Image generation |
|<#90EE90>🟩| Local |
|<#FFB6C1>🟥| YouTube |
endlegend

' === OpenAI text generation ===
rectangle "gen_word" as W #ADD8E6
rectangle "gen_fact" as F #ADD8E6

W --> F

rectangle "optimize_img_prompt" as IP #ADD8E6
rectangle "gen_meta" as M #ADD8E6

F --> IP
F --> M

' === Parallel validation (starts early) ===
rectangle "validate_info_with_ai" as VAL #ADD8E6

F --> VAL
IP --> VAL
M --> VAL

' === Image generation ===
rectangle "gen_images" as IM #D8BFD8
IP --> IM

' === Local processing ===
rectangle "gen_audio" as A #ADD8E6
rectangle "make_video" as V #90EE90

F --> A
A --> V
IM --> V

' === Upload (gated by validation) ===
rectangle "do_upload" as U #FFB6C1

V --> U
M --> U
VAL --> U

@enduml
